# NickEvents backend — copy to .env and fill in real values (development only;
# production values live in the hosting platform's environment variables).

# Required in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# dev: true | prod: false
DJANGO_DEBUG=true

# Comma-separated lists
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# sqlite:///db.sqlite3 for local dev, or a Neon pooled connection string:
# postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_CONN_MAX_AGE=60

# Set to "None" (with secure HTTPS) when frontend and API are on different
# registrable domains (e.g. two Vercel projects). "Lax" works for same-site.
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax

# Timezone
DJANGO_TIME_ZONE=Africa/Kinshasa

# Rate limits
THROTTLE_AUTH_RATE=20/min
THROTTLE_PUBLIC_RATE=120/min
