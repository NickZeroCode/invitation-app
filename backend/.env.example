# NickEvents backend — copy to .env and fill in real values (development only;
# production values live in the hosting platform's environment variables).

# Required in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# dev: true | prod: false
DJANGO_DEBUG=true

# Comma-separated lists
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# sqlite:///db.sqlite3 for local dev, or a Neon pooled connection string.
# Query parameters are forwarded to libpq verbatim (sslmode, channel_binding):
# postgresql://user:pass@ep-....pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_CONN_MAX_AGE=60

# Set to "None" (with secure HTTPS) when frontend and API are on different
# registrable domains (e.g. two Vercel projects). "Lax" works for same-site.
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax

# Timezone
DJANGO_TIME_ZONE=Africa/Kinshasa

# Rate limits
THROTTLE_AUTH_RATE=20/min
THROTTLE_PUBLIC_RATE=120/min

# --- S3-compatible object storage (cover images) — required in production ---
# Required. The storage project's bucket (this Neon project: invitation-app).
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Endpoint + region of the storage project. The boto3-native spellings
# AWS_ENDPOINT_URL_S3 and AWS_REGION are accepted as well.
AWS_S3_ENDPOINT_URL=
# The region must be complete and exact (e.g. us-east-2) — a truncated value
# such as "us-east-" fails at startup with ImproperlyConfigured.
AWS_S3_REGION_NAME=us-east-2
# Required for S3-compatible endpoints (their TLS wildcard covers only the
# bare host): path is the default; "virtual" only for real AWS S3.
# AWS_S3_ADDRESSING_STYLE=path
# AWS_QUERYSTRING_EXPIRE=3600
